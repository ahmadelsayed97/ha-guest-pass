# URL of the Home Assistant instance the proxy sits in front of (reachable from the proxy host).
HA_URL=http://homeassistant.local:8123

# Long-lived access token created in HA (Profile -> Security -> Long-lived access tokens).
# The proxy holds this. It is never sent to guest browsers.
HA_TOKEN=replace-with-long-lived-token

# SPIKE ONLY: shared secret guests present to the proxy. Min 32 chars.
# Generate: openssl rand -base64 48
# Replaced by signed, scoped, expiring tokens in the auth phase.
GUEST_SECRET=replace-with-at-least-32-random-chars

# Address/port the proxy listens on. Bind to a LAN interface; LAN check is also enforced in code.
HOST=0.0.0.0
PORT=8124
