# Home Assistant instance the proxy sits in front of, reachable from the proxy host.
HA_URL=http://homeassistant.local:8123

# Long-lived access token from HA (Profile > Security). Stays on the proxy.
HA_TOKEN=replace-with-long-lived-token

# Key that signs guest links. 32 bytes as hex: openssl rand -hex 32
SIGNING_KEY=replace-with-64-hex-characters

# Secret for the /admin page. At least 32 characters: openssl rand -hex 24
ADMIN_SECRET=replace-with-at-least-32-random-chars

# Where guest records are kept. Holds scopes and expiry, never tokens.
GUEST_STORE_FILE=./guests.json

# Listen address and port. Non-LAN peers are refused in code regardless of HOST.
HOST=0.0.0.0
PORT=8124
